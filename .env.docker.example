# Docker-specific environment for Marveen.
# Copy to `.env.docker` and fill in. compose reads it via `env_file`.
# NEVER commit `.env.docker` with real secrets — only this .example is tracked.

# --- Core ---
# Dashboard port. Numeric only (the egress-gate hook rejects non-numeric values).
WEB_PORT=3420
# Bind address INSIDE the container. Must be 0.0.0.0 for the published port to be
# reachable from the host (the app default is 127.0.0.1 = container loopback only).
# Leave as 0.0.0.0 for Docker; the container network is isolated and /api/* stays
# behind the Bearer token gate.
WEB_HOST=0.0.0.0
# Container timezone (affects scheduling/heartbeat timestamps).
TZ=Europe/Budapest

# --- Fleet / token usage ---
# RESPAWN_ENABLED gates whether the main agent channel session is spawned and
# kept alive — a `claude` CLI session the heartbeat drives (and thus CONSUMES
# CLAUDE API TOKENS) even when idle. Shipped as 0 here so a plain
# `docker compose up` runs the DASHBOARD ONLY — ideal for evaluating the UI.
RESPAWN_ENABLED=0
# Agent backend: 'worker' (default) keeps persistent `claude` tmux worker
# sessions alive; 'sdk' runs agents via the SDK per-call with no persistent
# session. Paired with RESPAWN_ENABLED=0 this is the documented smoke/staging
# combo: NO persistent `claude` sessions at all, so an idle container spends
# nothing. To run the real fleet, set RESPAWN_ENABLED=1, remove this (or set
# 'worker'), AND provide Claude auth below.
MARVEEN_AGENT_BACKEND=sdk

# --- Claude authentication (headless container) ---
# The fleet spawns the `claude` CLI; for headless use provide ONE of these,
# OR mount your host ~/.claude read-only (see docker-compose.yml).
# (Only needed when RESPAWN_ENABLED=1 above.)
#   CLAUDE_CODE_OAUTH_TOKEN — long-lived setup token (`claude setup-token`, ~1 year)
#   ANTHROPIC_API_KEY       — API-key mode
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional branding / owner ---
# Identity set here is the durable SEED. The dashboard setup wizard writes to the
# app's .env too, which now PERSISTS across container recreates (the entrypoint
# keeps it on the store volume) -- so wizard changes are no longer lost on rebuild.
# BOT_NAME=Marveen
# BRAND_NAME=
# OWNER_NAME=Your Name

# --- Optional channels ---
# TELEGRAM_BOT_TOKEN=
# ALLOWED_CHAT_ID=

# --- Optional local-LLM offload (used only with the `ollama` compose profile) ---
# OLLAMA_URL=http://ollama:11434
